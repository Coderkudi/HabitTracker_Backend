{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "nodenext",

        "noEmit": false,

        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "index.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules", "generated"]
}
